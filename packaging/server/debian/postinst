#!/bin/bash
# postinst for farsight-server. Idempotent: re-running dpkg -i on a machine
# that already has some/all of Mosquitto, Telegraf, InfluxDB2 or Grafana
# installed must not reconfigure or restart those from scratch — same
# "detect, don't clobber" principle as the client package's Tailscale
# handling.
set -e

CONF=/etc/farsight/server.conf

echo "farsight-server: postinst"

# --- Mosquitto (plain Ubuntu universe package, no extra repo needed) ---
if ! dpkg -s mosquitto >/dev/null 2>&1; then
    echo "farsight-server: installing mosquitto..."
    apt-get update -qq
    apt-get install -y mosquitto mosquitto-clients
else
    echo "farsight-server: mosquitto already installed, leaving package as-is."
fi

# --- InfluxData repo, shared by Telegraf + InfluxDB 2.x ---
if ! dpkg -s telegraf >/dev/null 2>&1 || ! dpkg -s influxdb2 >/dev/null 2>&1; then
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://repos.influxdata.com/influxdata-archive.key \
        | gpg --dearmor -o /etc/apt/keyrings/influxdata-archive.gpg
    echo "deb [signed-by=/etc/apt/keyrings/influxdata-archive.gpg] https://repos.influxdata.com/debian stable main" \
        > /etc/apt/sources.list.d/influxdata.list
    apt-get update -qq
fi

if ! dpkg -s telegraf >/dev/null 2>&1; then
    echo "farsight-server: installing telegraf..."
    apt-get install -y telegraf
else
    echo "farsight-server: telegraf already installed, leaving package as-is."
fi

if ! dpkg -s influxdb2 >/dev/null 2>&1; then
    echo "farsight-server: installing influxdb2..."
    apt-get install -y influxdb2 influxdb2-cli
else
    echo "farsight-server: influxdb2 already installed, leaving package as-is."
fi

# --- Grafana repo + package ---
if ! dpkg -s grafana >/dev/null 2>&1; then
    echo "farsight-server: installing grafana..."
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://apt.grafana.com/gpg.key | gpg --dearmor -o /etc/apt/keyrings/grafana.gpg
    echo "deb [signed-by=/etc/apt/keyrings/grafana.gpg] https://apt.grafana.com stable main" \
        > /etc/apt/sources.list.d/grafana.list
    apt-get update -qq
    apt-get install -y grafana
else
    echo "farsight-server: grafana already installed, leaving package as-is."
fi

# --- Grafana SQLite datasource plugin (reads the same device-identity DB
# farsight-server writes to, see /var/lib/farsight/farsight.db below) ---
if [ ! -d /var/lib/grafana/plugins/frser-sqlite-datasource ]; then
    echo "farsight-server: installing Grafana SQLite datasource plugin..."
    grafana cli --homepath /usr/share/grafana --config /etc/grafana/grafana.ini \
        plugins install frser-sqlite-datasource || \
        echo "farsight-server: SQLite datasource plugin install failed, SQLite panels in Grafana won't work until fixed manually." >&2
else
    echo "farsight-server: Grafana SQLite datasource plugin already installed."
fi

# --- InfluxDB: bind loopback-only (only Grafana/Telegraf on this same host
# need it, never a remote peer, so this doesn't need the Tailscale IP) ---
INFLUX_NEEDS_RESTART=false
if ! grep -q '^http-bind-address' /etc/influxdb/config.toml 2>/dev/null; then
    echo 'http-bind-address = "127.0.0.1:8086"' >> /etc/influxdb/config.toml
    INFLUX_NEEDS_RESTART=true
fi
systemctl enable influxdb >/dev/null 2>&1 || true
if systemctl is-active --quiet influxdb; then
    [ "$INFLUX_NEEDS_RESTART" = true ] && systemctl restart influxdb
else
    systemctl start influxdb || true
fi

# --- InfluxDB one-time setup (org/bucket/token), idempotent ---
for i in 1 2 3 4 5; do
    influx ping >/dev/null 2>&1 && break
    sleep 1
done

TOKEN_FILE=/etc/farsight/influx_token
mkdir -p /etc/farsight
if [ ! -s "$TOKEN_FILE" ]; then
    if ! influx org list >/dev/null 2>&1; then
        echo "farsight-server: running initial InfluxDB setup..."
        PW=$(head -c24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')
        influx setup --username admin --password "$PW" --org farsight --bucket telemetry --force \
            > /tmp/farsight-influx-setup.log 2>&1 || \
            echo "farsight-server: influx setup failed, see /tmp/farsight-influx-setup.log" >&2
    fi
    TOKEN=$(grep -o 'token = "[^"]*"' /root/.influxdbv2/configs 2>/dev/null | head -1 | sed 's/token = "//;s/"$//')
    if [ -n "$TOKEN" ]; then
        umask 077
        printf '%s' "$TOKEN" > "$TOKEN_FILE"
    else
        echo "farsight-server: could not read InfluxDB token, Telegraf output will fail until $TOKEN_FILE is fixed manually." >&2
    fi
fi
TOKEN=$(cat "$TOKEN_FILE" 2>/dev/null || true)

# --- Allow raw HTML/iframe in Grafana Text panels — needed to embed
# farsight-server's own admin page (rename form) as a Grafana panel
# instead of a separate page the user has to navigate to on their own. ---
if grep -q '^;disable_sanitize_html' /etc/grafana/grafana.ini; then
    sed -i 's/^;disable_sanitize_html.*/disable_sanitize_html = true/' /etc/grafana/grafana.ini
elif ! grep -q '^disable_sanitize_html' /etc/grafana/grafana.ini; then
    printf '\n[panels]\ndisable_sanitize_html = true\n' >> /etc/grafana/grafana.ini
fi

# --- farsight-server's own device-identity database. Created by
# farsight-server itself on first start (see internal/store); the
# directory just needs to exist first, and needs to end up readable by the
# grafana user for the SQLite datasource plugin to query it directly. ---
mkdir -p /var/lib/farsight /var/lib/farsight/uploads

# --- Extension point for file-upload importers (see UPLOAD_DIR/
# IMPORTERS_DIR in server.conf) — empty by default, nothing shipped here.
# An admin drops in an executable named after a file extension to handle
# it; see examples/ in the repo for a sample (deliberately not installed
# by this package — proprietary/site-specific formats don't belong in the
# base product). ---
mkdir -p /etc/farsight/importers

# --- Grafana datasources: provisioned from a file, not the API — a real
# install has no admin sitting at the Grafana UI to click through this, and
# file provisioning is idempotent by name (re-running this just updates the
# same two datasources in place). ---
mkdir -p /etc/grafana/provisioning/datasources
cat > /etc/grafana/provisioning/datasources/farsight.yaml <<EOF
apiVersion: 1
datasources:
  - name: InfluxDB-Farsight
    type: influxdb
    access: proxy
    url: http://127.0.0.1:8086
    isDefault: true
    jsonData:
      version: Flux
      organization: farsight
      defaultBucket: telemetry
    secureJsonData:
      token: ${TOKEN}
  - name: SQLite-Farsight
    type: frser-sqlite-datasource
    access: proxy
    jsonData:
      path: /var/lib/farsight/farsight.db
EOF

# --- systemd: netconfig oneshot first, then the services that depend on it ---
systemctl daemon-reload
systemctl enable --now farsight-server-netconfig.service || \
    echo "farsight-server: netconfig failed (no Tailscale IP yet?), run 'systemctl restart farsight-server-netconfig' once the machine has joined the tailnet." >&2

for unit in mosquitto telegraf grafana-server farsight-server; do
    systemctl enable "$unit" >/dev/null 2>&1 || true
    if systemctl is-active --quiet "$unit"; then
        systemctl restart "$unit" || echo "farsight-server: failed to restart $unit, check 'journalctl -u $unit'." >&2
    else
        systemctl start "$unit" || echo "farsight-server: failed to start $unit, check 'journalctl -u $unit'." >&2
    fi
done

# farsight-server creates the SQLite file itself on first start (as root);
# make it readable by the grafana user so its SQLite datasource plugin can
# query it too. Give it a moment to actually exist first.
for i in 1 2 3 4 5; do
    [ -f /var/lib/farsight/farsight.db ] && break
    sleep 1
done
chmod 644 /var/lib/farsight/farsight.db 2>/dev/null || true

echo "farsight-server: install complete. Edit ${CONF} if needed. Dashboard and Grafana listen on this machine's Tailscale IP."

exit 0
