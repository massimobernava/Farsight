# /etc/farsight/server.conf
# Config file for farsight-server. Shipped as a debian conffile: local edits
# survive package upgrades.

# --- farsight-server (control plane dashboard) ---
# MQTT broker to subscribe to. Runs on the same host as Mosquitto, so the
# loopback address is normally correct — the broker itself is the thing
# bound to the Tailscale interface, not this client connection.
MQTT_BROKER=tcp://127.0.0.1:1883

# HTTP port for the dashboard (bound only on the Tailscale interface).
HTTP_PORT=8080

# Must match the client's WEBSOCKIFY_PORT (see /etc/farsight/client.conf on
# clients) — used to build each device's noVNC link.
WEBSOCKIFY_PORT=6080

# Optional SSH username hint shown next to each device's IP. Leave empty to
# just show the bare Tailscale IP.
SSH_USER=

# "tailscale" (default) binds the dashboard to this machine's Tailscale IP,
# never 0.0.0.0, per PROJECT_SPEC.md. "loopback" is only for local debugging
# without a tailnet.
BIND_INTERFACE=tailscale

# SQLite database for persisted device identity (display name, notes) —
# Grafana's SQLite datasource plugin reads the same file directly.
SQLITE_PATH=/var/lib/farsight/farsight.db

# Where files uploaded by clients (POST /devices/<tenant>/<device>/upload)
# get saved, under <tenant>/<device>/.
UPLOAD_DIR=/var/lib/farsight/uploads

# After saving an upload, farsight-server looks for an executable named
# after the file's extension (no dot) in this directory and runs it with
# (file-path, tenant_id, device_id) — e.g. IMPORTERS_DIR/dat for a .dat
# file. Nothing is installed here by default: farsight-server ships no
# format-specific parsers, this is purely an extension point. See
# docs/DEVELOPMENT.md and examples/ for a sample importer.
IMPORTERS_DIR=/etc/farsight/importers

# HTML template for GET /records?field=&value= (shows records linked by
# an arbitrary field — images, per-treatment data, ...). Edit this file to
# change how that page looks; farsight-server re-reads it on every
# request, no restart needed. Falls back to a built-in default if missing
# or invalid.
GALLERY_TEMPLATE=/etc/farsight/gallery.html.tmpl
