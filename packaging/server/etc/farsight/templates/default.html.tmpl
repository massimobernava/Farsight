{{/*
  Template di default per GET /records (vedi docs/DEVELOPMENT.md).
  Modifica questo file, o caricane uno nuovo con un altro nome (POST
  /templates/<nome>, anche da C con farsight_upload_template) e selezionalo
  con ?template=<nome> nell'URL — non serve toccare il codice di
  farsight-server, ogni file viene riletto a ogni richiesta.

  Variabili disponibili:
    .Filters    map[string]string dei filtri passati nell'URL
                (?filter.<campo>=<valore>, uno o più) — usa
                {{index .Filters "campo"}}
    .Records    slice di record che matchano tutti i filtri, ognuno con:
      .RecordID, .TenantID, .DeviceID
      .Data     map[string]string dei campi del record — usa
                {{index .Data "nomecampo"}}. Se esiste .Data.filename, è
                pensato per essere mostrato come immagine (link a
                /devices/<tenant>/<device>/files/<filename>, URL relativo,
                funziona da solo).

  Se questo file manca o non è un template valido, farsight-server usa
  automaticamente un template minimo integrato (nessun errore per
  l'utente finale, solo un log sul server).
*/}}
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<title>Farsight — Record</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 1rem; background: #111; color: #eee; }
  .record { border: 1px solid #333; border-radius: 6px; padding: 0.8rem; margin-bottom: 1rem; }
  .record h3 { margin: 0 0 0.5rem 0; font-size: 0.95rem; color: #64b5f6; }
  .record img { max-width: 350px; max-height: 350px; display: block; margin-bottom: 0.5rem; border-radius: 4px; }
  table { border-collapse: collapse; }
  td { padding: 0.15rem 0.6rem 0.15rem 0; font-size: 0.85rem; }
  td.key { color: #888; }
  .muted { color: #888; }
</style>
</head>
<body>
{{range .Records}}
<div class="record">
  <h3>{{.RecordID}}</h3>
  {{if index .Data "filename"}}
    <a href="/devices/{{.TenantID}}/{{.DeviceID}}/files/{{index .Data "filename"}}" target="_blank">
      <img src="/devices/{{.TenantID}}/{{.DeviceID}}/files/{{index .Data "filename"}}" alt="{{.RecordID}}">
    </a>
  {{end}}
  <table>
  {{range $key, $value := .Data}}
    {{if ne $key "filename"}}<tr><td class="key">{{$key}}</td><td>{{$value}}</td></tr>{{end}}
  {{end}}
  </table>
</div>
{{else}}
<p class="muted">Nessun record trovato per questi filtri.</p>
{{end}}
</body>
</html>
