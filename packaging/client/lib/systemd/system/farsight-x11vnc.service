[Unit]
Description=Farsight x11vnc (attaches to X11_DISPLAY, Tailscale-only)
After=network-online.target tailscaled.service farsight-xvfb.service
Wants=network-online.target
Wants=farsight-xvfb.service

[Service]
Type=simple
ExecStart=/usr/bin/farsight-x11vnc-wrapper
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
