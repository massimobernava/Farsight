[Unit]
Description=Farsight x11vnc (attaches to existing X11 session, Tailscale-only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/farsight-x11vnc-wrapper
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
