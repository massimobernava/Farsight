[Unit]
Description=Farsight websockify + noVNC proxy (Tailscale-only)
After=network-online.target farsight-x11vnc.service
Wants=network-online.target
Requires=farsight-x11vnc.service

[Service]
Type=simple
ExecStart=/usr/bin/farsight-vnc-proxy-wrapper
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
