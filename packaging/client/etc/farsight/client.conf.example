# /etc/farsight/client.conf
# Config file for farsight-client. Shipped as a debian conffile: local edits
# survive package upgrades.

# --- farsight-agent (telemetry) ---
# MQTT broker URL of the central farsight-server, reachable over Tailscale.
MQTT_BROKER=tcp://100.64.0.1:1883

# Tenant/group this machine belongs to. Prototype phase: static, set by hand.
TENANT_ID=default

# Device identifier. Defaults to the machine hostname if left empty.
DEVICE_ID=

# How often to publish attributes (and telemetry, if enabled below), in
# seconds. Attributes (Tailscale IP, desktop reachability) always publish
# regardless of PUBLISH_TELEMETRY — they're what the dashboard needs.
PUBLISH_INTERVAL_SECONDS=30

# Whether to also publish CPU/RAM/disk as time-series telemetry (visible in
# Grafana, not the dashboard). Not "standard" — your choice, off doesn't
# break anything else.
PUBLISH_TELEMETRY=true

# --- Tailscale ---
# Coordination server for `tailscale up --login-server=...`. Leave empty to
# use Tailscale's own official service. Point this at a Headscale instance
# URL in the future to migrate off Tailscale SaaS without code changes.
TS_LOGIN_SERVER=

# --- x11vnc / websockify ---
# Optional VNC password file (created with `x11vnc -storepasswd`). Leave
# empty to run x11vnc without a password (VPN membership is the primary
# access control).
VNC_PASSWORD_FILE=

# X11 display x11vnc attaches to. If nothing is already listening here
# (no logged-in desktop), farsight-xvfb starts a virtual display on this
# same number automatically — see farsight-xvfb-wrapper. If something's
# already there (a real desktop session), it's left alone.
X11_DISPLAY=:0

# Resolution/depth for the virtual display, only used when farsight-xvfb
# actually has to create one (see X11_DISPLAY above).
XVFB_RESOLUTION=1920x1080x24

# Local TCP port x11vnc listens on (Tailscale interface only).
VNC_PORT=5900

# Port websockify/noVNC listens on (Tailscale interface only).
WEBSOCKIFY_PORT=6080
