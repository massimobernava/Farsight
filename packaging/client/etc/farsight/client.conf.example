# /etc/farsight/client.conf
# Config file for farsight-client. Shipped as a debian conffile: local edits
# survive package upgrades.

# --- farsight-agent (telemetry) ---
# MQTT broker URL of the central farsight-server, reachable over Tailscale.
MQTT_BROKER=tcp://100.64.0.1:1883

# Device identifier — the only identity this machine has on the wire.
# Defaults to the machine hostname if left empty. Which tenant this
# device belongs to is decided entirely server-side by an admin (see
# docs/MULTI-TENANCY.md) — nothing to set here, a new device just shows
# up under the "default" tenant until someone moves it.
DEVICE_ID=

# How often to publish attributes (and telemetry, if enabled below), in
# seconds. Attributes (Tailscale IP, desktop reachability) always publish
# regardless of PUBLISH_TELEMETRY — they're what the dashboard needs.
PUBLISH_INTERVAL_SECONDS=30

# Whether to also publish CPU/RAM/disk as time-series telemetry (visible in
# Grafana, not the dashboard). Not "standard" — your choice, off doesn't
# break anything else.
PUBLISH_TELEMETRY=true

# --- Tailscale ---
# Coordination server for `tailscale up --login-server=...`. Leave empty to
# use Tailscale's own official service. Point this at a Headscale instance
# URL in the future to migrate off Tailscale SaaS without code changes.
TS_LOGIN_SERVER=

# --- x11vnc / websockify ---
# Optional VNC password file (created with `x11vnc -storepasswd`). Leave
# empty to run x11vnc without a password (VPN membership is the primary
# access control).
VNC_PASSWORD_FILE=

# X11 display x11vnc attaches to. If nothing is already listening here
# (no logged-in desktop), farsight-xvfb starts a virtual display on this
# same number automatically — see farsight-xvfb-wrapper. If something's
# already there (a real desktop session), it's left alone.
X11_DISPLAY=:0

# Resolution/depth for the virtual display, only used when farsight-xvfb
# actually has to create one (see X11_DISPLAY above).
XVFB_RESOLUTION=1920x1080x24

# Whether farsight-xvfb starts a welcome xterm on a virtual display it
# creates (never touches a real, already-existing desktop session).
# Default: yes — shows a working terminal instead of a blank screen on
# first connect, with a short message on how to change things (window
# manager, autostart program, running as a different user). Independent
# of X11_AUTOSTART_CMD below: have one, the other, both, or neither.
X11_START_XTERM=true

# Optional: a program to launch automatically on that same virtual
# display, alongside the xterm above (or instead of it, if you set
# X11_START_XTERM=false). Commented out by default — nothing extra
# starts. Point this at your own app's launch command, or at a window
# manager (e.g. `openbox`, if installed separately — see the message in
# the default xterm for how).
#X11_AUTOSTART_CMD=

# Which user farsight-xvfb runs Xvfb and the two settings above as
# (empty = root, same as before this setting existed). Most GUI apps
# refuse to run as root, and expect a real user's home directory/D-Bus
# session/etc — set this to a real, existing username for anything
# beyond the default xterm. Only affects a display Farsight itself
# creates: x11vnc and websockify always stay root, and never touch a
# real desktop session's user either way.
#X11_SESSION_USER=

# Local TCP port x11vnc listens on (Tailscale interface only).
VNC_PORT=5900

# Port websockify/noVNC listens on (Tailscale interface only).
WEBSOCKIFY_PORT=6080
